{
  "name": "@skillbill/reactlace",
  "version": "1.0.0",
  "private": false,
  "author": "skillbill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skillbill/reactlace.git"
  },
  "bugs": {
    "url": "https://github.com/Skillbill/reactlace/issues"
  },
  "homepage": "https://skillbill.github.io/reactlace/",
  "files": [
    "dist-react/**"
  ],
  "keywords": [
    "components",
    "shoelace",
    "ui library",
    "react library",
    "primereact"
  ],
  "type": "module",
  "types": "./dist-react/index.d.ts",
  "main": "./dist-react/reactlace.umd.cjs",
  "module": "./dist-react/reactlace.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-react/index.d.ts",
        "default": "./dist-react/reactlace.js"
      },
      "require": "./dist-react/reactlace.umd.cjs"
    },
    "./styles/reactlace.css": {
      "import": "./dist-react/styles/index.css",
      "require": "./dist-react/styles/index.css"
    },
    "./styles/theme_primereact.css": {
      "import": "./dist-react/styles/theme.css",
      "require": "./dist-react/styles/theme.css"
    }
  },
  "scripts": {
    "dev": "vite --config vite.config.react.ts",
    "build": "tsc --project tsconfig.react.json --noEmit && vite build --config vite.config.react.ts",
    "preview": "vite preview --config vite.config.react.ts",
    "type-check": "tsc --project tsconfig.react.json --noEmit",
    "lint": "eslint ./src-react --ext .tsx,.ts --fix",
    "storybook": "storybook dev -p 6007 -c .storybook-react",
    "build-storybook": "storybook build -c .storybook-react -o docs-react",
    "build-publish": "vite build --config vite.config.react.ts && npm publish --access public"
  },
  "peerDependencies": {
    "@mdi/svg": "^7.4.47",
    "@shoelace-style/shoelace": "^2.17.1",
    "primereact": "^10.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.4.0",
    "@storybook/addon-essentials": "^8.1.1",
    "@storybook/addon-interactions": "^8.1.1",
    "@storybook/addon-links": "^8.1.1",
    "@storybook/blocks": "^8.1.1",
    "@storybook/react": "^8.1.1",
    "@storybook/react-vite": "^8.1.1",
    "@storybook/test": "^8.1.1",
    "@types/node": "^18.19.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.49.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.8.0",
    "postcss": "^8.4.33",
    "storybook": "^8.1.1",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.3.0",
    "vite": "^5.0.10",
    "vite-plugin-dts": "^3.7.1"
  }
}
